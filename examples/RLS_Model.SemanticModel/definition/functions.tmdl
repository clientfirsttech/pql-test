/// Object Level Security (OLS) Assertions - PQL.Assert.OLS namespace
/// Publisher: PQL (Power Query Lint)
/// These functions test metadata visibility to verify OLS is properly configured.
/// Use with "View as" role context in Power BI Desktop to validate security settings.
/// Asserts that a table is hidden from metadata (OLS metadataPermission = none).
/// Use this when a role should NOT have access to view or query a table.
function 'PQL.Assert.OLS.TableShouldBeHidden' =
		(testName : STRING, tableName : STRING) =>
			VAR _Tables = INFO.VIEW.TABLES()
			VAR _IsVisible = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table '" & tableName & "' should be HIDDEN from metadata",
				"Actual", IF(_IsVisible, "VISIBLE (OLS not working)", "HIDDEN (OLS working)"),
				"Passed", NOT _IsVisible
			)
	lineageTag: 4511b513-8f23-4e12-a0a4-37e9d153ab5b

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.4.0

/// Asserts that a table is visible in metadata (OLS allows access).
/// Use this when a role SHOULD have access to view or query a table.
function 'PQL.Assert.OLS.TableShouldBeVisible' =
		(testName : STRING, tableName : STRING) =>
			VAR _Tables = INFO.VIEW.TABLES()
			VAR _IsVisible = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table '" & tableName & "' should be VISIBLE in metadata",
				"Actual", IF(_IsVisible, "VISIBLE (correct)", "HIDDEN (unexpected)"),
				"Passed", _IsVisible
			)
