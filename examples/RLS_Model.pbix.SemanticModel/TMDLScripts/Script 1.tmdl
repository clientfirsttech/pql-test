createOrReplace
	function 'PQL.Assert.RetrieveTestsV2' =
			() =>
				VAR _BaseFunctions =
					SELECTCOLUMNS(
						FILTER(
							INFO.FUNCTIONS("ORIGIN", "2"),
							OR(RIGHT([FUNCTION_NAME], 5) = ".Test", RIGHT([FUNCTION_NAME], 6) = ".Tests")
						),
						"Name", [FUNCTION_NAME]
					)
				RETURN
					ADDCOLUMNS(
						_BaseFunctions,
						"Description",
						VAR _funcName = [Name]
						RETURN
						IFERROR(
							MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [Description]),
							BLANK()
						),
						"PQLAssert_ImpersonatedUserName",
						VAR _funcName = [Name]
						VAR _funcID =
							IFERROR(
								MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
								BLANK()
							)
						RETURN
						IFERROR(
							MAXX(
								FILTER(
									INFO.ANNOTATIONS(),
									[Name] = "PQLAssert_ImpersonatedUserName"
										&& [ObjectID] = _funcID
								),
								[Value]
							),
							BLANK()
						),
						"PQLAssert_RoleName",
						VAR _funcName = [Name]
						VAR _funcID =
							IFERROR(
								MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
								BLANK()
							)
						RETURN
						IFERROR(
							MAXX(
								FILTER(
									INFO.ANNOTATIONS(),
									[Name] = "PQLAssert_RoleName"
										&& [ObjectID] = _funcID
								),
								[Value]
							),
							BLANK()
						)
					)
		lineageTag: 2a52d7e1-1154-4fb7-9a77-369cf378c65e
	
		annotation DAXLIB_PackageId = PQL.Assert
	
		annotation DAXLIB_PackageVersion = 0.3.1