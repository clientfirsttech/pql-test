				"Expected", "Odd share >= " & FORMAT(minPct, "0.##") & "%",
				"Actual", FORMAT(_OddPct, "0.##") & "% (" & FORMAT(_OddCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")",
