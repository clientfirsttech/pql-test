model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Functions

	annotation PBI_QueryGroupOrder = 1

queryGroup DMVs

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Base Queries'

	annotation PBI_QueryGroupOrder = 3

queryGroup 'Low-Code Coverage'

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SharePointSiteURL","GetNextLink","GetJsonFromSharePoint","ConvertSharePointJsonToTable","GetLowCodeCoverageData","Build Information","Calculation Dependencies","Low-Code Coverage Source","Tables","Measures Table","CalculatedColumns","Low-Code Coverage Measures","Power BI Dataset Components","Test Bridge Table","Tests","Power BI Component Types","Information"]

annotation PBI_ProTooling = ["DevMode"]

ref table Tests
