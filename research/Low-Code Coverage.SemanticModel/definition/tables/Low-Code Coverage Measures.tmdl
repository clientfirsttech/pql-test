/// Measure Table
table 'Low-Code Coverage Measures'
	lineageTag: 23920b89-ce15-4d09-a174-57b390280d34

	measure 'Number of Components With Tests' = CALCULATE(COUNTROWS('Power BI Dataset Components'),FILTER(VALUES('Power BI Dataset Components'[Has Test]),'Power BI Dataset Components'[Has Test] = 1)) + 0
		formatString: 0
		displayFolder: Coverage
		lineageTag: 0ee838a3-2c4e-4120-a4ea-1d4b46f1504e

	measure 'Number of Components To Be Tested' = COUNTROWS('Power BI Dataset Components')
		formatString: 0
		displayFolder: Coverage
		lineageTag: 5de4d819-18e3-4c7c-a644-c970edb55c6f

	measure 'Low-Code Coverage' = DIVIDE([Number of Components With Tests],[Number of Components To Be Tested],0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Coverage
		lineageTag: 19a948f9-b517-48aa-ab14-303d1ede3624

	measure 'Low-Code Coverage Target' = .8
		formatString: 0%;-0%;0%
		displayFolder: Coverage
		lineageTag: 846d9f6c-eba4-4949-99cb-5962d14f9873

	measure 'List of Component Name Values' =
			
			VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('Power BI Component Types'[Component Name])
			VAR __MAX_VALUES_TO_SHOW = 3
			RETURN IF(__DISTINCT_VALUES_COUNT = __MAX_VALUES_TO_SHOW,"All Components",
				IF(
					__DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,
					CONCATENATE(
						CONCATENATEX(
							TOPN(
								__MAX_VALUES_TO_SHOW,
								VALUES('Power BI Component Types'[Component Name]),
								'Power BI Component Types'[Component Name],
								ASC
							),
							'Power BI Component Types'[Component Name],
							", ",
							'Power BI Component Types'[Component Name],
							ASC
						),
						", etc."
					),
					CONCATENATEX(
						VALUES('Power BI Component Types'[Component Name]),
						'Power BI Component Types'[Component Name],
						", ",
						'Power BI Component Types'[Component Name],
						ASC
					)
				))
		displayFolder: Display
		lineageTag: 744c96cf-9355-4d39-8b17-258b7ed8a33a

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "ConcatenateValues"
				}

		annotation PBI_FormatHint = {"isText":true}

	measure 'Latest Selected Build' = MAX('Power BI Dataset Components'[SharePoint List ID])
		formatString: 0
		displayFolder: Display
		lineageTag: eec1c1c2-7146-4ef8-a422-83a10b2897fe

	measure 'Number of Components To Be Tested For Latest Build' = CALCULATE([Number of Components To Be Tested],FILTER(VALUES('Power BI Dataset Components'[SharePoint List ID]),'Power BI Dataset Components'[SharePoint List ID]=MAX('Power BI Dataset Components'[SharePoint List ID])))
		formatString: 0
		displayFolder: Coverage
		lineageTag: ab52190d-7aef-4410-a21a-d1e40692615c

	measure 'Number of Components With Tests For Latest Build' = CALCULATE([Number of Components With Tests],FILTER(VALUES('Power BI Dataset Components'[SharePoint List ID]),'Power BI Dataset Components'[SharePoint List ID]=MAX('Power BI Dataset Components'[SharePoint List ID])))
		formatString: 0
		displayFolder: Coverage
		lineageTag: 4e426d30-5f87-417c-89b3-eed1c958dae8

	measure 'Test Expression Selected' = SELECTEDVALUE('Tests'[Expression],"Please select a row from the table above to see the test.")
		displayFolder: Display
		lineageTag: 5d5182b7-cc3c-4fd2-aa9a-3c60b29d4f38

		annotation PBI_FormatHint = {"isText":true}

	column Column1
		dataType: string
		isHidden
		lineageTag: 5822357e-26c0-4be6-9b2d-d72f8be2f3d8
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isText":true}

	partition 'Low-Code Coverage Measures-60b314e2-1e31-49e3-b874-707475aaa2a8' = m
		mode: import
		queryGroup: 'Low-Code Coverage'
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

