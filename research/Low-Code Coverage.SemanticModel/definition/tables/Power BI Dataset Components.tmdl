	column 'Is Part of Latest Build' = CALCULATE(MAX('Power BI Dataset Components'[SharePoint List ID]),FILTER('Power BI Dataset Components',EARLIER('Power BI Dataset Components'[Power BI Dataset Name])='Power BI Dataset Components'[Power BI Dataset Name])) = 'Power BI Dataset Components'[SharePoint List ID]
