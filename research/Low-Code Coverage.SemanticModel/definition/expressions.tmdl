/// Base URL for the SharePoint site that stores the Low-Code Coverage data.  The URL should not end with a '/'.
expression SharePointSiteURL = "https://kerski.sharepoint.com/sites/DataOpsDemo" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 9369eed6-b568-41bf-aae7-cdf6ca3fc060
	queryGroup: Parameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression GetNextLink =
		(jsonResults) =>
		let
		    #"Converted to Table" = Record.ToTable(jsonResults),
		    #"Expanded Value" = Table.ExpandRecordColumn(#"Converted to Table", "Value", {"__next"}, {"Value.__next"}),
		    #"Removed Columns" = Table.RemoveColumns(#"Expanded Value",{"Name"})
		in
		    Table.FirstValue(#"Removed Columns")
	lineageTag: 2ab62c3b-d879-46bf-8a27-c2d13e6be60c
	queryGroup: Functions

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression GetJsonFromSharePoint = ```
		(url) =>
		let 
		    //Set Options and odata/json response
		    Options = [RelativePath=url,Headers=[Accept="application/json;odata=verbose"]],
		    RawData = Web.Contents(SharePointSiteURL, Options),
		    Json    = Json.Document(RawData)
		in  Json
		```
	lineageTag: 9f2bd10d-1e10-46b5-b706-56ff888e141a
	queryGroup: Functions

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression ConvertSharePointJsonToTable =
		(Json) =>
		let
		    d = Json[d],
		    #"Converted to Table" = Record.ToTable(d),
		    Value = #"Converted to Table"{0}[Value],
		    #"Converted to Table1" = Table.FromList(Value, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		    Result = Table.ExpandRecordColumn(#"Converted to Table1", "Column1", {"ID","Title", "CalculationDependencies", "Tables", "Columns", "Measures","Created"}, {"SharePoint List ID","Build ID", "Calculation Dependencies", "Tables", "Columns", "Measures","Created"})
		in
		    Result
	lineageTag: a7f26d81-8892-48a7-b7d1-99b2fda192aa
	queryGroup: Functions

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression GetLowCodeCoverageData = ```
		(Source, Url, Count) => 
		let 
		    Json  = GetJsonFromSharePoint(Url),
		    NextLink = GetNextLink(Json),
		    Tbl = ConvertSharePointJsonToTable(Json),
		    NewTbl = if Source is null then Tbl else Table.Combine({Source,Tbl}),
		    BaseUrlLength = Text.Length(SharePointSiteURL),
		    Result = if NextLink is null then NewTbl else GetLowCodeCoverageData(NewTbl,Text.Range(NextLink,BaseUrlLength),Count + 1)
		in
		    Result
		```
	lineageTag: ed2c9c1a-2fc6-432e-a8ed-102575b10eec
	queryGroup: Functions

