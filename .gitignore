# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# pytest
.pytest_cache/

# Local ad-hoc test/debug run artifacts (repo root only)
/pytest-summary.txt
/pytest-exitcode.txt
/tmp-failing-*.txt
/test.json
/dax-results-examples-*.json
/gitleaks-*-report.json

# promptfoo eval runtime artifacts
tests/promptfoo/results.json
tests/promptfoo/.promptfoo/

# Local harness installs from `pql-test skill --install`
# (These belong in consumer repos, not this one; committed skills live in skills/)
.claude/skills/pql-test/
.cursor/skills/pql-test/
.windsurf/skills/pql-test/
python/.claude/
python/.cursor/
python/.windsurf/
python/.github/

# pql-test config
.pql-test/
**/cache.abf
**/localSettings.json
examples/OLS_Model.SemanticModel/definition/functions.tmdl

# Credentials / dotenv variants
# The canonical .env pattern (any directory) plus common rename variants
# people use to "hide" a .env from this rule (renamedenv, env.local,
# .env.local, .env.production, etc.).  Templates with a .example suffix
# are explicitly preserved below.
**/.env
**/.env.*
**/env
**/env.*
**/*env.local
**/*env.production
**/*env.staging
renamedenv
# Allow public-safe templates back in
!**/.env.example
!**/env.example
!**/*.env.template

# Private keys / cert material
*.pem
*.p12
*.pfx
*.key
**/id_rsa
**/id_ed25519

# hypothesis example database (pql-odcs property tests)
.hypothesis/
