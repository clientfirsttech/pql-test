# pql-test live-service credentials
#
# Copy this file to .env (same directory) and fill in your values.
# .env is git-ignored — never commit real credentials.
#
# These variables are consumed by tests/test_live_service.py when running
# the @pytest.mark.live integration test suite:
#
#   cd python
#   pytest tests/test_live_service.py -v -m live
#
# They can also be set directly in your CI/CD pipeline secrets instead.

# ---------------------------------------------------------------------------
# Remote Power BI Premium / Fabric XMLA endpoint
# ---------------------------------------------------------------------------

# Azure AD tenant GUID
PQL_TENANT_ID=<your-tenant-guid>

# Power BI workspace GUID  (the workspace that contains your semantic model)
PQL_WORKSPACE_ID=<your-workspace-guid>

# Dataset / semantic model GUID
PQL_DATASET_ID=<your-dataset-guid>

# ---------------------------------------------------------------------------
# Cloud environment  (optional — defaults to Public commercial cloud)
# ---------------------------------------------------------------------------
# Valid values: Public, Germany, China, USGov, USGovHigh, USGovDoD
# PQL_ENVIRONMENT=Public

# ---------------------------------------------------------------------------
# Service principal credentials
#
# Register an app in Azure AD and grant it the "Dataset.ReadWrite.All"
# (or "Dataset.Read.All") Power BI service permission.
# Add the service principal to the Power BI workspace as a Member or Admin.
#
# If both CLIENT_ID and CLIENT_SECRET are blank, pql-test attempts an
# interactive browser-based login instead.
# ---------------------------------------------------------------------------

# Application (client) ID of the service principal
PQL_CLIENT_ID=<your-app-client-id>

# Client secret for the service principal
PQL_CLIENT_SECRET=<your-client-secret>
